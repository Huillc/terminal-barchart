//@version=6
// Liquidez 4H: solo la liquidez que FALTA por tomar. NO es señal de entrada.
// Une con una línea los giros pendientes vecinos ($$$), con su precio real, aunque no estén al mismo nivel.
// Un giro solo, con reacción clara, se marca con $. Cuando una mecha lo toma, desaparece.
// Los giros se confirman con velas cerradas: aparecen con retraso y no se repintan.
indicator("Liquidez 4H", overlay = true, max_lines_count = 80, max_labels_count = 40)

grpA = "Qué mostrar"
nArriba = input.int(3, "Grupos pendientes arriba", minval = 0, maxval = 10, group = grpA)
nAbajo = input.int(3, "Grupos pendientes abajo", minval = 0, maxval = 10, group = grpA)
verSueltos = input.bool(true, "Incluir giros solos ($)", group = grpA)
grpB = "Criterio"
tf = input.timeframe("240", "Temporalidad", group = grpB)
velas = input.int(5, "Velas a cada lado del giro", minval = 2, maxval = 20, group = grpB)
maxVelas = input.int(80, "Unir giros separados hasta (velas)", minval = 5, maxval = 200, group = grpB)
maxDif = input.float(3.0, "Unir giros con diferencia hasta (ATR)", minval = 0.25, maxval = 10.0, step = 0.25, group = grpB)
minReac = input.float(1.5, "Reacción mínima de un giro solo (ATR)", minval = 0.5, maxval = 10.0, step = 0.5, group = grpB)
grpC = "Colores"
colAlta = input.color(#e6e9ee, "Liquidez arriba", group = grpC)
colBaja = input.color(#e6e9ee, "Liquidez abajo", group = grpC)
grosor = input.int(2, "Grosor de línea", minval = 1, maxval = 4, group = grpC)

const int MAX_GUARDADOS = 60

type Liq
    float p
    int t
    float reac

datos(int n) =>
    float ph = ta.pivothigh(high, n, n)
    float pl = ta.pivotlow(low, n, n)
    float a = ta.atr(14)
    float rh = (ph - ta.lowest(low, n)) / a
    float rl = (ta.highest(high, n) - pl) / a
    [ph[1], pl[1], a[1], time[n + 1], rh[1], rl[1]]

[ph, pl, atrTf, tPiv, reacH, reacL] = request.security(syminfo.tickerid, tf, datos(velas), lookahead = barmerge.lookahead_on)

var array<Liq> arriba = array.new<Liq>()
var array<Liq> abajo = array.new<Liq>()
var int ultH = 0
var int ultL = 0
var float atrUlt = na
var array<line> lineas = array.new<line>()
var array<label> textos = array.new<label>()

agregar(array<Liq> z, float p, int t, float r) =>
    z.push(Liq.new(p, t, r))
    if z.size() > MAX_GUARDADOS
        z.shift()

// Liquidez tomada: una mecha cruza el giro y deja de contar
revisar(array<Liq> z, int lado) =>
    int cuenta = 0
    if z.size() > 0
        for i = z.size() - 1 to 0
            Liq k = z.get(i)
            if time > k.t and (lado > 0 ? high > k.p : low < k.p)
                z.remove(i)
                cuenta += 1
    cuenta

if not na(atrTf)
    atrUlt := atrTf
    if not na(ph) and tPiv != ultH
        ultH := tPiv
        agregar(arriba, ph, tPiv, reacH)
    if not na(pl) and tPiv != ultL
        ultL := tPiv
        agregar(abajo, pl, tPiv, reacL)

int tomadaArriba = revisar(arriba, 1)
int tomadaAbajo = revisar(abajo, -1)

// Agrupa giros vecinos en el tiempo y en precio, y dibuja los N grupos más cercanos al precio
dibujar(array<Liq> z, int n, int lado, color c) =>
    if n > 0 and z.size() > 0
        array<int> ini = array.new<int>()
        array<int> fin = array.new<int>()
        array<float> dist = array.new<float>()
        int msVela = timeframe.in_seconds(tf) * 1000
        int a = 0
        for i = 0 to z.size() - 1
            bool corta = i == z.size() - 1
            if not corta
                Liq x = z.get(i)
                Liq y = z.get(i + 1)
                corta := y.t - x.t > maxVelas * msVela or math.abs(y.p - x.p) > maxDif * atrUlt
            if corta
                bool solo = a == i
                if not solo or (verSueltos and z.get(i).reac >= minReac)
                    float d = 1e20
                    for j = a to i
                        d := math.min(d, math.abs(z.get(j).p - close))
                    ini.push(a)
                    fin.push(i)
                    dist.push(d)
                a := i + 1
        if dist.size() > 0
            array<int> orden = dist.sort_indices(order.ascending)
            for g = 0 to math.min(n, orden.size()) - 1
                int o = orden.get(g)
                int i0 = ini.get(o)
                int i1 = fin.get(o)
                if i1 > i0
                    for j = i0 to i1 - 1
                        Liq x = z.get(j)
                        Liq y = z.get(j + 1)
                        lineas.push(line.new(x.t, x.p, y.t, y.p, xloc = xloc.bar_time, color = c, width = grosor, style = line.style_solid))
                    Liq m0 = z.get(i0)
                    Liq m1 = z.get(i1)
                    textos.push(label.new((m0.t + m1.t) / 2, (m0.p + m1.p) / 2, "$$$", xloc = xloc.bar_time, style = lado > 0 ? label.style_label_down : label.style_label_up, color = color(na), textcolor = c, size = size.small))
                else
                    Liq x = z.get(i0)
                    lineas.push(line.new(x.t, x.p, math.min(time, x.t + 8 * msVela), x.p, xloc = xloc.bar_time, color = color.new(c, 35), width = 1, style = line.style_solid))
                    textos.push(label.new(x.t, x.p, "$", xloc = xloc.bar_time, style = lado > 0 ? label.style_label_down : label.style_label_up, color = color(na), textcolor = c, size = size.small))

if barstate.islast
    for l in lineas
        line.delete(l)
    for t in textos
        label.delete(t)
    lineas.clear()
    textos.clear()
    dibujar(arriba, nArriba, 1, colAlta)
    dibujar(abajo, nAbajo, -1, colBaja)

alertcondition(tomadaArriba > 0, "Liquidez tomada arriba", "Liquidez tomada arriba en {{ticker}}")
alertcondition(tomadaAbajo > 0, "Liquidez tomada abajo", "Liquidez tomada abajo en {{ticker}}")

//@version=6
// Liquidez 4H: solo la liquidez que FALTA por tomar y la más cercana al precio, arriba y abajo. NO es señal de entrada.
// Tipos: máximos/mínimos iguales ($$$), líneas de tendencia con 3 toques ($$$) y giros con reacción clara ($).
// En cuanto una mecha toma el nivel, desaparece. Los giros se confirman con velas cerradas: aparecen con retraso y no se repintan.
indicator("Liquidez 4H", overlay = true, max_lines_count = 40, max_labels_count = 40)

grpA = "Qué mostrar"
nArriba = input.int(3, "Niveles pendientes arriba", minval = 0, maxval = 10, group = grpA)
nAbajo = input.int(3, "Niveles pendientes abajo", minval = 0, maxval = 10, group = grpA)
verSueltos = input.bool(true, "Incluir giros con reacción ($)", group = grpA)
verLineas = input.bool(true, "Incluir líneas de tendencia", group = grpA)
grpB = "Criterio"
tf = input.timeframe("240", "Temporalidad", group = grpB)
velas = input.int(5, "Velas a cada lado del giro", minval = 2, maxval = 20, group = grpB)
tol = input.float(0.4, "Tolerancia de iguales y de línea (en ATR)", minval = 0.05, maxval = 1.0, step = 0.05, group = grpB)
minReac = input.float(1.5, "Reacción mínima de un giro suelto (en ATR)", minval = 0.5, maxval = 10.0, step = 0.5, group = grpB)
grpC = "Colores"
colAlta = input.color(#e6e9ee, "Liquidez arriba", group = grpC)
colBaja = input.color(#e6e9ee, "Liquidez abajo", group = grpC)

const int MAX_GUARDADOS = 40

type Liq
    float p1
    int t1
    float p2
    int t2
    float reac = 0.0
    int toques = 1
    bool inclinada = false

datos(int n) =>
    float ph = ta.pivothigh(high, n, n)
    float pl = ta.pivotlow(low, n, n)
    float a = ta.atr(14)
    float rh = (ph - ta.lowest(low, n)) / a
    float rl = (ta.highest(high, n) - pl) / a
    [ph[1], pl[1], a[1], time[n + 1], rh[1], rl[1]]

[ph, pl, atrTf, tPiv, reacH, reacL] = request.security(syminfo.tickerid, tf, datos(velas), lookahead = barmerge.lookahead_on)

var array<Liq> arriba = array.new<Liq>()
var array<Liq> abajo = array.new<Liq>()
var array<float> hP = array.new<float>()
var array<int> hT = array.new<int>()
var array<float> lP = array.new<float>()
var array<int> lT = array.new<int>()
var int ultH = 0
var int ultL = 0
var array<line> lineas = array.new<line>()
var array<label> textos = array.new<label>()

precioEn(Liq k, int t) =>
    k.inclinada ? k.p1 + (k.p2 - k.p1) * (t - k.t1) / (k.t2 - k.t1) : k.p1

// Un giro nuevo: si cae cerca de un nivel pendiente, lo refuerza; si no, crea uno.
nuevoGiro(array<Liq> z, float p, int t, float a, float r, int lado) =>
    bool unido = false
    if z.size() > 0
        for k in z
            if not k.inclinada and math.abs(k.p1 - p) <= tol * a
                k.toques += 1
                k.reac := math.max(k.reac, r)
                k.p1 := lado > 0 ? math.max(k.p1, p) : math.min(k.p1, p)
                k.p2 := k.p1
                k.t2 := t
                unido := true
                break
    if not unido
        z.push(Liq.new(p, t, p, t, r))
        if z.size() > MAX_GUARDADOS
            z.shift()

// Línea de tendencia: 3 giros seguidos alineados
probarLinea(array<Liq> z, array<float> P, array<int> T, float a, int lado) =>
    int m = P.size()
    if m >= 3
        float a1 = P.get(m - 3)
        float a2 = P.get(m - 2)
        float a3 = P.get(m - 1)
        int t1 = T.get(m - 3)
        int t2 = T.get(m - 2)
        int t3 = T.get(m - 1)
        bool orden = lado > 0 ? a1 > a2 and a2 > a3 : a1 < a2 and a2 < a3
        if orden and t3 > t1
            float medio = a1 + (a3 - a1) * (t2 - t1) / (t3 - t1)
            if math.abs(a2 - medio) <= tol * a
                z.push(Liq.new(a1, t1, a3, t3, 0.0, 3, true))
                if z.size() > MAX_GUARDADOS
                    z.shift()

guardarGiro(array<float> P, array<int> T, float p, int t) =>
    P.push(p)
    T.push(t)
    if P.size() > 6
        P.shift()
        T.shift()

// Liquidez tomada: una mecha cruza el nivel y deja de contar
revisar(array<Liq> z, int lado) =>
    int cuenta = 0
    if z.size() > 0
        for i = z.size() - 1 to 0
            Liq k = z.get(i)
            float p = precioEn(k, time)
            if time > k.t2 and (lado > 0 ? high > p : low < p)
                z.remove(i)
                cuenta += 1
    cuenta

if not na(atrTf)
    if not na(ph) and tPiv != ultH
        ultH := tPiv
        nuevoGiro(arriba, ph, tPiv, atrTf, reacH, 1)
        guardarGiro(hP, hT, ph, tPiv)
        probarLinea(arriba, hP, hT, atrTf, 1)
    if not na(pl) and tPiv != ultL
        ultL := tPiv
        nuevoGiro(abajo, pl, tPiv, atrTf, reacL, -1)
        guardarGiro(lP, lT, pl, tPiv)
        probarLinea(abajo, lP, lT, atrTf, -1)

int tomadaArriba = revisar(arriba, 1)
int tomadaAbajo = revisar(abajo, -1)

// Dibuja solo los N niveles válidos más cercanos al precio
dibujar(array<Liq> z, int n, int lado, color c) =>
    if n > 0 and z.size() > 0
        array<float> dist = array.new<float>()
        array<int> idx = array.new<int>()
        for [i, k] in z
            bool fuerte = k.toques >= 2 or k.inclinada
            bool vale = k.inclinada ? verLineas : fuerte or (verSueltos and k.reac >= minReac)
            if vale
                dist.push(math.abs(precioEn(k, time) - close))
                idx.push(i)
        if dist.size() > 0
            array<int> orden = dist.sort_indices(order.ascending)
            for j = 0 to math.min(n, orden.size()) - 1
                Liq k = z.get(idx.get(orden.get(j)))
                bool fuerte = k.toques >= 2 or k.inclinada
                // Línea de punto a punto: del primer toque al último, con el texto encima (arriba) o debajo (abajo)
                int tFin = fuerte ? k.t2 : math.min(time, k.t1 + 12 * timeframe.in_seconds(tf) * 1000)
                lineas.push(line.new(k.t1, k.p1, tFin, k.p2, xloc = xloc.bar_time, color = color.new(c, fuerte ? 0 : 35), width = 1, style = line.style_solid))
                int tTxt = (k.t1 + tFin) / 2
                textos.push(label.new(tTxt, (k.p1 + k.p2) / 2, fuerte ? "$$$" : "$", xloc = xloc.bar_time, style = lado > 0 ? label.style_label_down : label.style_label_up, color = color(na), textcolor = c, size = size.small))

if barstate.islast
    for l in lineas
        line.delete(l)
    for t in textos
        label.delete(t)
    lineas.clear()
    textos.clear()
    dibujar(arriba, nArriba, 1, colAlta)
    dibujar(abajo, nAbajo, -1, colBaja)

alertcondition(tomadaArriba > 0, "Liquidez tomada arriba", "Liquidez tomada arriba en {{ticker}}")
alertcondition(tomadaAbajo > 0, "Liquidez tomada abajo", "Liquidez tomada abajo en {{ticker}}")
